---
// Фон «радиоволны»: фронты от антенны и пакет сигнала через ионосферу.
interface Props {
  height?: string;
  label?: string;
}
const { height = '420px', label = 'Анимация: радиоволны от антенны' } = Astro.props;
---

<div class="fx fx-waves" style={`--fx-h: ${height}`}>
  <canvas role="img" aria-label={label}></canvas>
  <div class="fx-content"><slot /></div>
</div>

<script>
  import { mountRadioWaves } from '../lib/fx/radiowaves';
  document.querySelectorAll<HTMLElement>('.fx-waves').forEach(mountRadioWaves);
</script>
