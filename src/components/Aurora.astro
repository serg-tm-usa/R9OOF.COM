---
// Фон «северное сияние». Содержимое слота ложится поверх.
interface Props {
  height?: string;
  label?: string;
}
const { height = '420px', label = 'Анимация: северное сияние' } = Astro.props;
---

<div class="fx fx-aurora" style={`--fx-h: ${height}`}>
  <canvas role="img" aria-label={label}></canvas>
  <div class="fx-content"><slot /></div>
</div>

<script>
  import { mountAurora } from '../lib/fx/aurora';
  document.querySelectorAll<HTMLElement>('.fx-aurora').forEach(mountAurora);
</script>
