---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const entries = await getCollection('handbook');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <p class="meta">
    <a href="/handbook">Справочник</a> &middot; {entry.data.category}
  </p>
  <h1>{entry.data.title}</h1>
  <p class="lede">{entry.data.summary}</p>

  <Content />

  <p class="meta">Обновлено {formatDate(entry.data.updated)}</p>
</Base>
