---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const entries = await getCollection('rda');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary}>
  <p class="meta">
    <a href="/rda">Хроника RDA</a> &middot; {formatDate(entry.data.date)}
  </p>
  <h1>{entry.data.title}</h1>
  <p class="lede">{entry.data.summary}</p>

  <table>
    <tbody>
      {entry.data.rdaRefs.length > 0 && (
        <tr><th>Районы RDA</th><td>{entry.data.rdaRefs.join(', ')}</td></tr>
      )}
      {entry.data.qsos !== undefined && (
        <tr><th>Связей</th><td>{entry.data.qsos}</td></tr>
      )}
    </tbody>
  </table>

  <Content />
</Base>
