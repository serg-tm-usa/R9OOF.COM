---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../../lib/format';

const entries = (await getCollection('rda', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const totalQso = entries.reduce((sum, e) => sum + (e.data.qsos ?? 0), 0);
const refs = new Set(entries.flatMap((e) => e.data.rdaRefs));
---

<Base title="Хроника RDA" description="Активации районов RDA: даты, номера, результаты.">
  <h1>Хроника RDA</h1>
  <p class="lede">
    Выезды на активацию районов. Каждая запись содержит номера RDA, дату и итог по
    связям.
  </p>

  {entries.length > 0 && (
    <table>
      <tbody>
        <tr><th>Выездов</th><td>{entries.length}</td></tr>
        <tr><th>Районов</th><td>{refs.size}</td></tr>
        <tr><th>Связей всего</th><td>{totalQso}</td></tr>
      </tbody>
    </table>
  )}

  {entries.length === 0 ? (
    <div class="placeholder">
      <p><strong>Пока пусто.</strong></p>
      <p>Добавьте файл в <code>src/content/rda/</code>, и запись появится здесь.</p>
    </div>
  ) : (
    <ul class="grid">
      {entries.map((entry) => (
        <li class="card">
          <p class="meta">{formatDate(entry.data.date)}</p>
          <h3><a href={`/rda/${entry.id}`}>{entry.data.title}</a></h3>
          <p>{entry.data.summary}</p>
          {entry.data.rdaRefs.length > 0 && (
            <p>{entry.data.rdaRefs.map((r) => <span class="tag">{r}</span>)}</p>
          )}
        </li>
      ))}
    </ul>
  )}
</Base>
